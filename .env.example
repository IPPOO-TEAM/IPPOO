# ── Auth0 (Authentification utilisateurs + Google SSO) ──────
# Trouvez ces valeurs dans : Auth0 Dashboard > Applications > [votre app]
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id_here
VITE_AUTH0_AUDIENCE=https://api.ippoo-aptdc.com

# ── Admin IPPOO (connexion back-office) ─────────────────────
# Ces identifiants protègent /admin — ne jamais les exposer publiquement
VITE_ADMIN_EMAIL=admin@ippoo-aptdc.com
VITE_ADMIN_PASSWORD=ChangeMe_StrongPassword!

# ── Supabase (Base de données) ───────────────────────────────
# Trouvez ces valeurs dans : Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
